AMOCRM_SECRET_KEY=YOUR_SECRET_KEY
AMO_CRM_INTEGRATION_KEY=YOUR_INTEGRATION_KEY
AMO_CRM_NAME=YOUR_ACCOUNT_NAME

AMO_CRM_DOMAIN=amocrm.ru

PORT=3000
HOST=localhost

AMO_CRM_API_URL=https://${AMO_CRM_NAME}.${AMO_CRM_DOMAIN}/api/v4/
AMO_CRM_REDIRECT_URL=http://${HOST}:${PORT}/auth/callback 

AUTH_URL=https://www.${AMO_CRM_DOMAIN}/oauth?client_id=${AMO_CRM_INTEGRATION_KEY}&mode=post_message
AMO_CRM_OAUTH_TOKEN_URL=https://${AMO_CRM_NAME}.${AMO_CRM_DOMAIN}/oauth2/access_token